# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.env
venv/
.venv/

# ── Credentials — NEVER commit these ──────────────────────────────────────
swing_generator/credentials/service_account.json
swing_generator/credentials.json
swing_generator/token.json
credentials/
*.json.key

# ── Large data cache (parquet files — persisted by GitHub Actions cache) ──
swing_generator/cache/
swing_generator/cache_ma200/
swing_generator/cache_ma500/

# ── Generated output (rebuilt on every run) ───────────────────────────────
swing_generator/output/
swing_generator/output_ma200/
swing_generator/output_ma500/
swing_generator/output_intraday/
swing_generator/webapp/publish/

# ── Node / wrangler ────────────────────────────────────────────────────────
node_modules/
package.json
package-lock.json
**/.wrangler/

# ── Local clutter (installers, manuals, backups, worktrees) ───────────────
*.pkg
*.dmg
*.bak
*.pdf
_backup_*/
.claude/worktrees/
swing_generator/*.png
swing_generator/*.zip

# ── macOS ──────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Logs ───────────────────────────────────────────────────────────────────
logs/
